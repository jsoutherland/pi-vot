{
  "name": "pi-vot",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/server.ts",
    "build": "tsc --noEmit",
    "start": "node --experimental-strip-types src/server.ts --production",
    "test": "node --experimental-strip-types --test",
    "test:browser": "playwright test",
    "test:pi-smoke": "node --experimental-strip-types scripts/pi-smoke.ts",
    "verify:vendor": "node scripts/verify-vendor-assets.mjs",
    "compile:release": "tsc -p tsconfig.release.json",
    "assemble:release": "node scripts/assemble-release.mjs",
    "package:win": "npm run compile:release && npm run assemble:release && node scripts/package-win.mjs",
    "release:win": "npm run verify:vendor && npm test && npm run build && npm run test:browser && npm run package:win"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "marked": "16.4.1",
    "typescript": "5.9.3"
  }
}
